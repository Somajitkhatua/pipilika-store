# -------------------- Pipilika backend configuration --------------------
# Copy this file to ".env" and fill in your real values.

# ---- How the site is reached (used for the "Track your order" button in emails) ----
WEBSITE_URL=http://localhost:3000

# ---- SMTP (your email "engine") -----------------------------------------------
# Gmail example (works well with an App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com          (your real Gmail address)
#   SMTP_PASS=yourapppassword        (NOT your normal password — create an App Password:
#                                     Google > Security > 2-Step Verification > App passwords)
# Outlook/Office365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@outlook.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pipilika Handicrafts <no-reply@pipilika.in>   # "Name <email>" shown as sender

# ---- Who receives a copy of each order (your congratulations inbox) -----------
COMPANY_EMAIL=yourcompany@email.com

# ---- Port the site runs on ----------------------------------------------------
PORT=3000